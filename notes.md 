use leptos::*;
use exmex::prelude::*;

#[component]
pub fn Calculator(formula_from_db: String, initial_data: Vec<f64>) -> impl IntoView {
    // 1. Храним "скомпилированную" формулу. 
    // Если формула из БД валидна, FlatEx<f64> будет жить здесь.
    let expr = create_memo(move |_| {
        // Парсим один раз при изменении строки formula_from_db
        exmex::parse_val::<f64>(&formula_from_db).ok()
    });

    // 2. Сигналы для входных данных (инпутов)
    let (data, set_data) = create_signal(initial_data);

    // 3. Реактивный результат
    let display_result = create_memo(move |_| {
        match expr.get() {
            Some(e) => {
                // Вычисляем на лету при изменении данных
                e.eval(&data.get()).map(|v| v.to_string()).unwrap_or_else(|_| "Ошибка вычислений".to_string())
            }
            None => "Ошибка в формуле".to_string(),
        }
    });

    view! {
        <div>
            <p>"Результат: " {display_result}</p>
        </div>
    }
}



