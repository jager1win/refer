    .map(|v| v.parse::<f64>().unwrap_or(0.0))
    .collect();
let names: Vec<&str> = raw_data.keys().cloned().collect();

// 2. Парсим формулу с учетом этих имен
let expr = exmex::parse_with_vars::<f64>("price * count", &names).unwrap();

// 3. Считаем
let result = expr.eval(&values).unwrap();
